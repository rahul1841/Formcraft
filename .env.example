# ---------------------------------------------------------------------------
# Formcraft environment
# Copy this file to .env.local and fill in the values:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Restart `npm run dev` after changing anything here.
# ---------------------------------------------------------------------------

# Required. MongoDB connection string. The database name can live in the URI
# path — local: mongodb://127.0.0.1:27017/formcraft
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/formcraft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/formcraft

# Optional. Overrides the database name from MONGODB_URI (handy when the URI has none).
MONGODB_DB=

# Required. Signing key for the session cookie — 32+ random characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this app; used to build shareable /f/<slug> form links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, seed only. Email for the demo admin created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@formcraft.dev

# Optional, seed only. Password for that demo admin (min 8 characters).
SEED_ADMIN_PASSWORD=formcraft123

# Optional, seed only. Display name for that demo admin.
SEED_ADMIN_NAME=Demo Admin
